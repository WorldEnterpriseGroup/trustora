{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustora.net/schemas/careers-intake-v1.json",
  "title": "Trustora career application intake",
  "description": "The browser-to-integration contract for Trustora career applications. The endpoint must validate again; this schema is not a substitute for server-side validation.",
  "type": "object",
  "additionalProperties": true,
  "required": ["application-id", "full-name", "email", "current-country", "time-zone", "role-title-or-problem", "work-authorization", "work-model", "availability", "applicant-consent"],
  "properties": {
    "application-id": { "type": "string", "format": "uuid", "maxLength": 64 },
    "full-name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "preferred-name": { "type": "string", "maxLength": 80 },
    "email": { "type": "string", "format": "email", "maxLength": 254 },
    "phone-or-whatsapp": { "type": "string", "maxLength": 80 },
    "current-country": { "type": "string", "minLength": 1, "maxLength": 80 },
    "city-region": { "type": "string", "maxLength": 120 },
    "regional-context": { "type": "string", "maxLength": 120 },
    "time-zone": { "type": "string", "minLength": 1, "maxLength": 120 },
    "role-title-or-problem": { "type": "string", "minLength": 1, "maxLength": 180 },
    "role-interests": { "type": "array", "items": { "type": "string", "maxLength": 160 }, "maxItems": 12 },
    "professional-languages": { "type": "array", "items": { "type": "string", "maxLength": 80 }, "maxItems": 16 },
    "work-evidence": { "type": "string", "maxLength": 5000 },
    "work-authorization": { "type": "string", "minLength": 1, "maxLength": 160 },
    "work-model": { "type": "string", "minLength": 1, "maxLength": 80 },
    "availability": { "type": "string", "minLength": 1, "maxLength": 100 },
    "travel-or-relocation": { "type": "string", "maxLength": 120 },
    "authorization-notes": { "type": "string", "maxLength": 2000 },
    "education-level": { "type": "string", "maxLength": 120 },
    "education-field": { "type": "string", "maxLength": 160 },
    "compensation-currency": { "type": "string", "maxLength": 60 },
    "compensation-expectation": { "type": "string", "maxLength": 120 },
    "resume-link": { "type": "string", "format": "uri", "maxLength": 500 },
    "linkedin": { "type": "string", "format": "uri", "maxLength": 500 },
    "github": { "type": "string", "format": "uri", "maxLength": 500 },
    "portfolio-or-publications": { "type": "string", "format": "uri", "maxLength": 500 },
    "cover-note": { "type": "string", "maxLength": 6000 },
    "source": { "type": "string", "maxLength": 300 },
    "business-unit": { "const": "Trustora" },
    "crm-target": { "const": "dream.crm.dynamics.com" },
    "integration-handoff": { "enum": ["azure-function-or-logic-app"] },
    "schema-version": { "const": "trustora-careers-v1" },
    "applicant-consent": { "const": "yes" },
    "website": { "type": "string", "maxLength": 0 }
  }
}
