---
import '../styles/global.css';
import SiteHeader from '../components/chrome/SiteHeader.astro';
import SiteFooter from '../components/chrome/SiteFooter.astro';
import { site } from '../data/site';
import { getSeoMetadata } from '../data/seo';

interface Props {
  title: string;
  description: string;
  currentPath?: string;
  darkHeader?: boolean;
  conversion?: boolean;
  noindex?: boolean;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  image?: string;
  seoTitle?: string;
  refreshAfterSeconds?: number;
  refreshTo?: string;
}

const {
  title,
  description,
  currentPath = Astro.url.pathname,
  darkHeader = false,
  conversion = false,
  noindex = false,
  type = 'website',
  publishedAt,
  updatedAt,
  image = site.socialImage,
  seoTitle = title,
  refreshAfterSeconds,
  refreshTo,
} = Astro.props;

const resolvedSeo = getSeoMetadata(currentPath, { title: seoTitle, description });
const metaTitle = resolvedSeo.title.length > 60 ? `${resolvedSeo.title.slice(0, 57).trimEnd()}…` : resolvedSeo.title;
const metaDescription = resolvedSeo.description;
const socialImageAlt = `${site.name} — ${metaTitle}`;

const interFontUrl =
  `https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800&display=swap&text=${encodeURIComponent(
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 .,:;!?'/()&@#-$%",
  )}`;

const requireHttpsEndpoint = (value: string | undefined, name: string) => {
  if (!value) throw new Error(`${name} must be configured for D365-only form delivery`);
  const url = new URL(value);
  if (url.protocol !== 'https:') throw new Error(`${name} must use HTTPS`);
  return url;
};
const publicIntakeEndpoint = requireHttpsEndpoint(import.meta.env.PUBLIC_TRUSTORA_INTAKE_API_URL?.trim(), 'PUBLIC_TRUSTORA_INTAKE_API_URL');
const careersEndpoint = requireHttpsEndpoint(import.meta.env.PUBLIC_CAREERS_API_URL?.trim(), 'PUBLIC_CAREERS_API_URL');
const apiOrigins = [...new Set([publicIntakeEndpoint.origin, careersEndpoint.origin])];
const connectSources = ["'self'", ...apiOrigins].join(' ');
const formActionSources = ["'self'", ...apiOrigins].join(' ');
const csp = [
  "default-src 'self'",
  "base-uri 'self'",
  `connect-src ${connectSources}`,
  "img-src 'self' https: data:",
  "font-src 'self' https://fonts.gstatic.com",
  "style-src 'self' https://fonts.googleapis.com 'unsafe-inline'",
  "script-src 'self' 'unsafe-inline'",
  "frame-ancestors 'self'",
  "object-src 'none'",
  `form-action ${formActionSources}`,
  'upgrade-insecure-requests',
].join('; ') + ';';
const refreshMeta =
  typeof refreshAfterSeconds === 'number' && refreshTo
    ? `${refreshAfterSeconds};URL=${new URL(refreshTo, site.url).toString()}`
    : null;

const canonical = new URL(currentPath, site.url).toString();
const structuredData = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description: metaDescription,
      mainEntityOfPage: canonical,
      datePublished: publishedAt?.toISOString(),
      dateModified: (updatedAt ?? publishedAt)?.toISOString(),
      author: { '@type': 'Organization', name: site.name, url: site.url },
      publisher: { '@type': 'Organization', name: site.name, url: site.url },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'ProfessionalService',
      name: site.name,
      legalName: site.legalName,
      url: site.url,
      description: site.description,
      email: site.email,
      areaServed: ['European Union', 'Australia', 'United States'],
      serviceType: 'Employer of Record and specialist talent services',
    };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {refreshMeta && <meta http-equiv="refresh" content={refreshMeta} />}
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="X-Frame-Options" content="SAMEORIGIN" />
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Permissions-Policy" content="accelerometer=(), autoplay=(), camera=(), cross-origin-isolated=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), keyboard-map=(), magnetometer=(), microphone=(), payment=(), usb=(), xr-spatial-tracking=()" />
    <meta name="description" content={metaDescription} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={darkHeader || conversion ? '#0b2740' : '#f5f6f7'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={interFontUrl} />
    <link rel="stylesheet" href={interFontUrl} />
    <noscript><link rel="stylesheet" href={interFontUrl} /></noscript>
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, site.url).toString()} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={new URL(image, site.url).toString()} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <title>{metaTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body class:list={{ 'conversion-page': conversion, 'home-page': currentPath === '/' }}>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader currentPath={currentPath} dark={darkHeader || conversion} conversion={conversion} />
    <main id="main-content"><slot /></main>
    {!conversion && <SiteFooter />}
    <script is:inline src="/scripts/corporate-email-validation.js"></script>
    <script is:inline src="/scripts/d365-form-submit.js"></script>
  </body>
</html>
