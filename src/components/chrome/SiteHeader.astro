---
import { navigation } from '../../data/site';
import MegaMenu from './MegaMenu.astro';

interface Props {
  currentPath?: string;
  dark?: boolean;
  conversion?: boolean;
}

const { currentPath = Astro.url.pathname, dark = false, conversion = false } = Astro.props;
const isCurrent = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(href));
---

<header class:list={['site-header', { 'is-dark': dark }]}>
  <div class="site-header-inner measure">
    <a class="brand" href="/" aria-label="Trustora home">
      <img src="/images/trustora-text-logo.svg" alt="Trustora" width="180" height="42" />
    </a>
    {!conversion && (
      <nav class="primary-nav" aria-label="Primary navigation">
        <ul>
          <li><MegaMenu /></li>
          {navigation.slice(1).map((item) => <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>)}
        </ul>
      </nav>
    )}
    {!conversion && <a class="button header-cta" href="/contact/">Talk to Trustora <span aria-hidden="true">↗</span></a>}
    {!conversion && (
      <details class="nav-drawer">
        <summary class="menu-toggle" aria-controls="mobile-navigation">
          <span class="menu-label">Menu</span>
          <span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
        </summary>
        <div class="drawer-panel" id="mobile-navigation">
          <nav aria-label="Mobile navigation">
            <ul>
              <li><MegaMenu mobile /></li>
              {navigation.slice(1).map((item) => <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>)}
              <li><a class="button" href="/contact/">Talk to Trustora <span aria-hidden="true">↗</span></a></li>
            </ul>
          </nav>
        </div>
      </details>
    )}
  </div>
</header>

<script>
  const drawers = document.querySelectorAll('.nav-drawer');

  drawers.forEach((drawer) => {
    const toggle = drawer.querySelector('.menu-toggle');
    const firstLink = drawer.querySelector<HTMLElement>('.drawer-panel a');

    if (!(drawer instanceof HTMLDetailsElement) || !(toggle instanceof HTMLElement)) return;

    const closeDrawer = (returnFocus = false) => {
      drawer.open = false;
      if (returnFocus) toggle.focus();
    };

    toggle.setAttribute('aria-expanded', String(drawer.open));

    drawer.addEventListener('toggle', () => {
      toggle.setAttribute('aria-expanded', String(drawer.open));
      if (drawer.open) requestAnimationFrame(() => firstLink?.focus());
    });

    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => closeDrawer());
    });

    drawer.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && drawer.open) {
        event.preventDefault();
        closeDrawer(true);
      }
    });

    document.addEventListener('click', (event) => {
      if (drawer.open && event.target instanceof Node && !drawer.contains(event.target)) closeDrawer();
    });
  });
</script>
