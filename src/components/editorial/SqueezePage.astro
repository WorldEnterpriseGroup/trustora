---
import Layout from '../../layouts/Layout.astro';
import SectionLabel from './SectionLabel.astro';
import Field from '../primitives/Field.astro';
import type { SqueezePageKey } from '../../data/squeezePages';
import { squeezePages } from '../../data/squeezePages';

interface Props { pageKey: SqueezePageKey; }
const { pageKey } = Astro.props;
const page = squeezePages[pageKey];
---

<Layout title={`${page.title} | Trustora`} description={page.description} currentPath={page.path} darkHeader conversion>
  <section class="conversion-page squeeze-page">
    <div class="measure conversion-grid">
      <div class="conversion-copy">
        <SectionLabel light>{page.eyebrow}</SectionLabel>
        <h1>{page.title}</h1>
        <p>{page.body}</p>
        <ul class="conversion-list">{page.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
      </div>
      <div class="conversion-panel">
        <span class="panel-index">Trustora / working material</span>
        <h2>Access the brief.</h2>
        <p>Share the outline of the decision. We will use the context to make the next conversation more useful.</p>
        <form class="form-stack" action="mailto:info@trustora.net" method="post" enctype="text/plain" data-corporate-email-only>
          <Field id={`${pageKey}-name`} name="name" label="Your name" required placeholder="Your name" />
          <Field id={`${pageKey}-email`} name="email" label="Work email" type="email" required placeholder="you@company.com" />
          <Field id={`${pageKey}-company`} name="company" label="Company" placeholder="Company name" />
          <div class="field"><label for={`${pageKey}-region`}>Primary region</label><select id={`${pageKey}-region`} name="region"><option>European Union</option><option>Australia</option><option>United States</option><option>More than one region</option></select></div>
          <div class="field"><label for={`${pageKey}-context`}>What are you deciding?</label><textarea id={`${pageKey}-context`} name="context" placeholder="Country, role, timing, or question."></textarea></div>
          <p class="form-note">Company email required. Gmail, Yahoo, Hotmail, and Outlook.com accounts are not eligible for this brief. Please do not include sensitive personal information. This is an operational starting point, not legal, tax, immigration, or employment advice.</p>
          <button class="button" type="submit">Request the brief <span aria-hidden="true">↗</span></button>
        </form>
        <p class="squeeze-fallback">This static site opens an email draft to <a href="mailto:info@trustora.net">info@trustora.net</a>. Prefer to read first? <a href={page.fallbackHref}>{page.fallbackLabel} ↗</a></p>
      </div>
    </div>
    <section class="measure squeeze-proof-strip" role="region" aria-label="Working principles">
      {page.proof.map((item, index) => <div><span>0{index + 1}</span><p>{item}</p></div>)}
    </section>
  </section>
</Layout>
