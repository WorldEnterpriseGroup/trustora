---
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  credit?: string;
  class?: string;
  priority?: boolean;
  sizes?: string;
  position?: string;
}

const {
  src,
  alt,
  caption,
  credit = 'Trustora brand archive',
  class: className = '',
  priority = false,
  sizes = '(max-width: 900px) 100vw, 50vw',
  position = '50% 50%',
} = Astro.props;
---

<figure class:list={['media-frame', className]} style={`--object-position: ${position}`}>
  <img
    src={src.src}
    alt={alt}
    width={src.width}
    height={src.height}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={priority ? 'high' : 'auto'}
  />
  {(caption || credit) && <figcaption class="media-caption"><span>{caption}</span><span class="media-credit">{credit}</span></figcaption>}
</figure>
