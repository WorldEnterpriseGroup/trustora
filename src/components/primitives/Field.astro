---
interface Props {
  id: string;
  name?: string;
  label: string;
  type?: 'text' | 'email' | 'tel';
  required?: boolean;
  placeholder?: string;
}

const { id, name = id, label, type = 'text', required = false, placeholder } = Astro.props;
---

<div class="field">
  <label for={id}>{label}{required && <span aria-hidden="true"> *</span>}</label>
  <input id={id} name={name} type={type} required={required} placeholder={placeholder} />
</div>
