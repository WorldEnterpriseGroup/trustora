---
import RecordLayout from '../../layouts/RecordLayout.astro';
import MediaFrame from '../../components/editorial/MediaFrame.astro';
import { media } from '../../data/media';
import { mediaManifest } from '../../data/site';
import { recordReviewed } from '../../data/record';
import { recordGraphTotals, recordGraphSections, recordGraphInventory, recordGraphGeneratedAt, recordGraphSiteTerms } from '../../data/recordGraph';

const sectionLabel: Record<string, string> = {
  top: 'Top level', services: 'Services', insights: 'Insights', briefings: 'Briefings',
  industries: 'Industries', locations: 'Locations', legal: 'Legal', careers: 'Careers',
  compare: 'Compare', record: 'Record Room',
};
const byWords = [...recordGraphInventory].sort((a, b) => b.words - a.words);
const longest = byWords[0];
const zeroImage = recordGraphInventory.find((r) => r.images === 0) ?? recordGraphInventory[0];
const mostImages = [...recordGraphInventory].sort((a, b) => b.images - a.images || b.words - a.words)[0];
const avg = (n: number, d: number) => (d ? (n / d).toFixed(1) : '—');
---

<RecordLayout
  title="Trustora content inventory | Record Room"
  description="Trustora's page inventory by section, with measurement rules and record archive references."
  currentPath="/record/metrics/"
  kicker="09 Record / Metrics"
  crumb="Content inventory"
  jump={[
    { href: '#record-metrics-totals-title', label: 'Route totals' },
    { href: '#record-metrics-inventory-title', label: 'Page inventory' },
    { href: '#record-metrics-distribution-title', label: 'Section averages' },
    { href: '#record-metrics-lanes-title', label: 'Review lanes' },
    { href: '#record-metrics-findings-title', label: 'Measured observations' },
    { href: '#record-metrics-language-title', label: 'Vocabulary index' },
    { href: '#record-metrics-inspection-title', label: 'Representative routes' },
    { href: '#record-metrics-method-title', label: 'Method and sources' },
  ]}
>
  <h1>Page inventory: structure and measurement rules.</h1>
  <p class="record-dek">This page reports the build-time inventory: route counts, main-zone word counts, content images, and title lengths. It is an artifact measurement, not a visitor, conversion, or accessibility-conformance report.</p>

  <aside class="record-scope" aria-label="Reading boundary">
    <h2>Inventory, not audience.</h2>
    <p><a href="/record/nav/">Site map</a> reports route connections. <a href="/record/marketing/">Market profile</a> records published company positioning. Metrics reports what this edition contains and how each value is calculated.</p>
  </aside>

  <div class="record-actions">
    <a class="button button-quiet" href="/record/nav/">Trace route structure</a>
    <a class="button button-quiet" href="/record/ops/">Carry a follow-up into Ops</a>
    <a class="button button-quiet" href="/record/marketing/">Read market signals</a>
    <button class="button button-quiet" id="record-metrics-download" type="button">Download JSON</button>
  </div>
  <script is:inline define:vars={{ inventory: recordGraphInventory }}>
    (() => {
      const btn = document.getElementById('record-metrics-download');
      if (!btn) return;
      btn.addEventListener('click', () => {
        const blob = new Blob([JSON.stringify(inventory, null, 2)], { type: 'application/json' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'trustora-route-inventory.json';
        a.click();
        URL.revokeObjectURL(a.href);
      });
    })();
  </script>

  <figure class="record-scene">
    <MediaFrame src={media['record-metrics']} alt={mediaManifest['record-metrics'].alt} caption={mediaManifest['record-metrics'].caption} credit={mediaManifest['record-metrics'].credit} sizes="(max-width: 900px) 100vw, 70vw" />
  </figure>

  <section aria-labelledby="record-metrics-totals-title">
    <h2 id="record-metrics-totals-title">Route totals by section.</h2>
    <p>Values below group the routes generated from the build's route families. “Main” means the <code>&lt;main&gt;</code> zone; image totals count content figures. Source generated {recordGraphGeneratedAt}.</p>
    <div class="record-stat-band">
      <div><strong>{recordGraphTotals.routes}</strong><span>Indexed routes</span></div>
      <div><strong>{recordGraphTotals.words.toLocaleString()}</strong><span>Main-zone words</span></div>
      <div><strong>{recordGraphTotals.images}</strong><span>Content images</span></div>
      <div><strong>{recordGraphTotals.handoffs}</strong><span>Body-copy handoffs</span></div>
    </div>
    <div class="record-definition">
      <table>
        <caption>Pages, words, images, and HTML sections by section</caption>
        <thead><tr><th scope="col">Section</th><th scope="col">Routes</th><th scope="col">Main words</th><th scope="col">Words / route</th><th scope="col">Images</th><th scope="col">Images / route</th><th scope="col">HTML sections (sum)</th></tr></thead>
        <tbody>
          {recordGraphSections.map((s) => (
            <tr><th scope="row">{sectionLabel[s.name]}</th><td>{s.routes}</td><td>{s.words.toLocaleString()}</td><td>{avg(s.words, s.routes)}</td><td>{s.images}</td><td>{avg(s.images, s.routes)}</td><td>{s.htmlSections}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <aside class="record-quick-start" aria-label="Inventory tools and source file">
    <h3>Inventory tools and source file.</h3>
    <p>Search every indexed route, filter by section, and open the exact page. The table below carries the unrounded source values behind every total on this page.</p>
    <div class="record-actions">
      <a class="button button-quiet" href="#record-metrics-inventory-title">Search inventory</a>
      <a class="button button-quiet" href="/record/nav/">Open site map</a>
      <a class="button button-quiet" href="/record/screens/">Open archive</a>
    </div>
    <dl class="record-chip-row">
      <div><dt>Rows in inventory</dt><dd>{recordGraphTotals.routes}</dd></div>
      <div><dt>Source edition</dt><dd>{recordGraphGeneratedAt}</dd></div>
    </dl>
  </aside>

  <section aria-labelledby="record-metrics-inventory-title">
    <h2 id="record-metrics-inventory-title">Find the routes behind the counts.</h2>
    <p>Every indexed route with its section, main-zone words, content images, and title length. Filter by text or section; the full list remains readable when JavaScript is unavailable.</p>
    <form class="record-filter" id="record-metrics-filter">
      <div class="field">
        <label for="record-metrics-search">Search routes</label>
        <input type="search" id="record-metrics-search" placeholder="Filter by file or title" autocomplete="off" />
      </div>
      <div class="field">
        <label for="record-metrics-section">Section</label>
        <select id="record-metrics-section">
          <option value="">All sections</option>
          {recordGraphSections.map((s) => <option value={s.name}>{sectionLabel[s.name]}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="record-metrics-lane">Review lane</label>
        <select id="record-metrics-lane">
          <option value="">All lanes</option>
          <option value="Review next">Review next</option>
          <option value="Context only">Context only</option>
          <option value="No source cue">No source cue</option>
        </select>
      </div>
      <div class="field">
        <label for="record-metrics-sort">Sort rows by</label>
        <select id="record-metrics-sort">
          <option value="source">Source order</option>
          <option value="lane">Review lane first</option>
          <option value="words">Main words, high to low</option>
          <option value="images">Content images, high to low</option>
          <option value="title">Title length, low to high</option>
        </select>
      </div>
      <button class="button button-quiet" type="reset">Reset view</button>
      <p class="record-result-count" id="record-metrics-count" role="status">Showing {recordGraphInventory.length} of {recordGraphInventory.length} indexed routes.</p>
    </form>
    <div class="record-definition">
      <table id="record-metrics-table">
        <caption>Complete route inventory with content measures</caption>
        <thead><tr><th scope="col">#</th><th scope="col">Route</th><th scope="col">Section</th><th scope="col">Main words</th><th scope="col">Media in capture</th><th scope="col">Metadata comparison</th><th scope="col">Source review lane</th><th scope="col">Inspect</th></tr></thead>
        <tbody>
          {recordGraphInventory.map((row, i) => {
            const lane = row.words === 0 ? 'Context only' : row.titleLen > 60 ? 'Review next' : 'No source cue';
            return (
            <tr data-search={`${row.file} ${row.title}`.toLowerCase()} data-section={row.section} data-words={row.words} data-images={row.images} data-titlelen={row.titleLen} data-lane={lane}><th scope="row">{i + 1}</th><td><a href={row.href}>{row.file}</a></td><td>{sectionLabel[row.section]}</td><td>{row.words.toLocaleString()}</td><td>{row.images} content · {row.htmlSections} sections</td><td>title {row.titleLen} · desc {row.descLen} · H1 {row.h1} · H2 {row.h2} · canonical {row.canonOk ? 'ok' : 'check'}</td><td>{lane}{lane === 'Review next' ? ` (titleLen=${row.titleLen})` : ''}</td><td><a href={row.href}>Open ↗</a></td></tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <script is:inline>
      (() => {
        const form = document.getElementById('record-metrics-filter');
        if (!form) return;
        const search = document.getElementById('record-metrics-search');
        const section = document.getElementById('record-metrics-section');
        const lane = document.getElementById('record-metrics-lane');
        const sort = document.getElementById('record-metrics-sort');
        const count = document.getElementById('record-metrics-count');
        const tbody = document.querySelector('#record-metrics-table tbody');
        const rows = [...tbody.querySelectorAll('tr')];
        const total = rows.length;
        const laneRank = { 'Review next': 0, 'Context only': 1, 'No source cue': 2 };
        const apply = () => {
          const q = search.value.trim().toLowerCase();
          const s = section.value;
          const l = lane.value;
          let visible = 0;
          rows.forEach((tr) => {
            const show = (!q || tr.dataset.search.includes(q)) && (!s || tr.dataset.section === s) && (!l || tr.dataset.lane === l);
            tr.hidden = !show;
            if (show) visible += 1;
          });
          const mode = sort.value;
          const vis = rows.filter((tr) => !tr.hidden);
          if (mode === 'lane') {
            vis.sort((a, b) => (laneRank[a.dataset.lane] ?? 9) - (laneRank[b.dataset.lane] ?? 9));
            vis.forEach((tr) => tbody.appendChild(tr));
          }
          const key = mode === 'words' ? 'words' : mode === 'images' ? 'images' : mode === 'title' ? 'titlelen' : null;
          if (key) {
            const desc = key !== 'titlelen';
            vis.sort((a, b) => desc ? Number(b.dataset[key]) - Number(a.dataset[key]) : Number(a.dataset[key]) - Number(b.dataset[key]));
            vis.forEach((tr) => tbody.appendChild(tr));
          }
          count.textContent = `Showing ${visible} of ${total} indexed routes.`;
        };
        search.addEventListener('input', apply);
        section.addEventListener('change', apply);
        lane.addEventListener('change', apply);
        sort.addEventListener('change', apply);
        form.addEventListener('reset', () => requestAnimationFrame(() => { apply(); search.focus(); }));
      })();
    </script>
  </section>

  <section aria-labelledby="record-metrics-distribution-title">
    <h2 id="record-metrics-distribution-title">Section-level averages.</h2>
    <p>Careers and legal are the densest per route (long-form policy and role pages); locations and industries are the lightest (focused briefs). Services carry the most images per route. Record Room sits in the middle on both measures.</p>
    <figure class="record-figure" aria-label="Average words and images per route by section">
      <figcaption><span>Figure 02 · Words and images per route by section</span><span>Bar length uses the largest average in this edition.</span></figcaption>
      <div class="record-figure-bars">
        <div><dt><strong>Words / route</strong></dt><dd></dd><span class="record-count">track 1</span></div>
        {[...recordGraphSections].sort((a, b) => (b.words / b.routes) - (a.words / a.routes)).slice(0, 8).map((s) => {
          const max = 1705.8;
          const v = s.words / s.routes;
          return (
            <div><dt>{sectionLabel[s.name]}</dt><dd><span class="record-figure-bar" style={`width: ${Math.max(4, Math.round((v / max) * 100))}%`}></span></dd><span class="record-count">{v.toFixed(1)} w/route</span></div>
          );
        })}
      </div>
      <div class="record-figure-bars">
        <div><dt><strong>Images / route</strong></dt><dd></dd><span class="record-count">track 2</span></div>
        {[...recordGraphSections].sort((a, b) => (b.images / b.routes) - (a.images / a.routes)).slice(0, 8).map((s) => {
          const maxI = Math.max(...recordGraphSections.map((x) => x.images / x.routes), 0.1);
          const v = s.images / s.routes;
          return (
            <div><dt>{sectionLabel[s.name]}</dt><dd><span class="record-figure-bar" style={`width: ${Math.max(4, Math.round((v / maxI) * 100))}%`}></span></dd><span class="record-count">{v.toFixed(1)} i/route</span></div>
          );
        })}
      </div>
      <figcaption><span>Text equivalent</span><span>Careers leads on words per route, followed by legal; services leads on images per route. Exact section counts, totals, and units are in the table above.</span></figcaption>
    </figure>
  </section>

  <section aria-labelledby="record-metrics-lanes-title">
    <h2 id="record-metrics-lanes-title">Source classification counts.</h2>
    <p>Labels mirror title-length and content signals, not page-quality scores. “Review next” flags long titles for a human look; “Context only” keeps wordless rows visible; “No source cue” means no flag recorded.</p>
    <dl class="record-chip-row" id="record-metrics-lanes">
      <div><dt>Review next</dt><dd>{recordGraphInventory.filter((r) => r.titleLen > 60).length} routes</dd></div>
      <div><dt>Context only</dt><dd>{recordGraphInventory.filter((r) => r.words === 0).length} routes</dd></div>
      <div><dt>No source cue</dt><dd>{recordGraphInventory.filter((r) => r.words > 0 && r.titleLen <= 60).length} routes</dd></div>
    </dl>
  </section>

  <section aria-labelledby="record-metrics-findings-title">
    <h2 id="record-metrics-findings-title">Computed observations from the inventory.</h2>
    <p>These observations are arithmetic over the indexed routes. They describe distribution; they do not turn a count into a quality verdict.</p>
    <div class="record-numbered">
      <article><span>01</span><div><h3>Long-form depth sits in careers and legal</h3><p>Careers averages the most words per route, followed by legal — role detail and the published operations policy. Locations averages the fewest.</p></div></article>
      <article><span>02</span><div><h3>Copy and media do not move together</h3><p>Services reach the most images per route while briefings, careers, and legal carry none in the main zone; insights pairs long copy with exactly one image per route.</p></div></article>
      <article><span>03</span><div><h3>Counts are labels, not verdicts</h3><p>Use the per-route table above and a human review before changing copy or metadata on the strength of a number alone.</p></div></article>
    </div>
  </section>

  <section aria-labelledby="record-metrics-language-title">
    <h2 id="record-metrics-language-title">The vocabulary index is not demand.</h2>
    <p>Token counts and the number of indexed routes containing each term. They can reveal repeated language to edit or clarify; they cannot establish search volume, sentiment, ranking, or visitor intent.</p>
    <div class="record-definition">
      <table>
        <caption>Top site terms by occurrence</caption>
        <thead><tr><th scope="col">Term</th><th scope="col">Occurrences</th><th scope="col">Indexed routes</th></tr></thead>
        <tbody>
          {recordGraphSiteTerms.map((t) => (
            <tr><th scope="row">{t.term}</th><td>{t.occurrences.toLocaleString()}</td><td>{t.pages}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="record-metrics-inspection-title">
    <h2 id="record-metrics-inspection-title">Open representative routes.</h2>
    <p>Three routes chosen by explicit criteria: the longest main zone, the most image-dense service route, and the first zero-image route.</p>
    <ol class="record-numbered" style="list-style: none">
      <article><span>01</span><div><h3>Longest main zone — {longest.file}</h3><p>{longest.words.toLocaleString()} main-zone words. <a href={longest.href}>Open route ↗</a></p></div></article>
      <article><span>02</span><div><h3>Most images — {mostImages.file}</h3><p>{mostImages.images} content images · {mostImages.words.toLocaleString()} main words. <a href={mostImages.href}>Open route ↗</a></p></div></article>
      <article><span>03</span><div><h3>First zero-image route — {zeroImage.file}</h3><p>{zeroImage.words.toLocaleString()} words, no main-zone image. <a href={zeroImage.href}>Open route ↗</a></p></div></article>
    </ol>
    <nav class="record-actions" aria-label="Related record pages">
      <a class="button button-quiet" href="/record/nav/">Trace route structure</a>
      <a class="button button-quiet" href="/record/ops/">Carry a follow-up into Ops</a>
      <a class="button button-quiet" href="/record/marketing/">Read market signals</a>
    </nav>
  </section>

  <section class="record-sources" aria-labelledby="record-metrics-method-title">
    <h2 id="record-metrics-method-title">Method and source fields.</h2>
    <div class="record-method-grid">
      <div><h3>Included in the calculation</h3><ul><li>Routes from the built output, grouped by first path segment.</li><li>Main-zone totals from the <code>&lt;main&gt;</code> zone only.</li><li>Words from rendered text, images from content figures, title lengths from built HTML.</li><li>Source integers remain the basis of every total.</li></ul></div>
      <div><h3>Excluded from this measurement</h3><ul><li>No traffic, search demand, conversions, or social sentiment.</li><li>No judgment of visual quality, readability, contrast, or screen-reader experience.</li><li>No claim beyond the routes in this build.</li><li>No inference that a count is a defect without human review.</li></ul></div>
    </div>
    <p>Record reviewed {recordReviewed}. This page preserves the measured values and their source boundary.</p>
  </section>
</RecordLayout>
