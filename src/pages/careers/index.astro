---
import Layout from '../../layouts/Layout.astro';
import SectionLabel from '../../components/editorial/SectionLabel.astro';
import MediaFrame from '../../components/editorial/MediaFrame.astro';
import { media } from '../../data/media';
import { mediaManifest } from '../../data/site';
---

<Layout title="Careers at Trustora" description="Join Trustora's global employment services team and help make cross-border work clearer for companies and people." currentPath="/careers/">
  <section class="page-hero"><div class="measure page-hero-grid"><div class="page-hero-copy"><SectionLabel>Careers at Trustora</SectionLabel><h1>Make global work feel more human.</h1><p>We are building a company for people who like the detail behind the detail: local context, careful operations, good judgment, and a clear answer when the obvious answer is wrong.</p></div><div class="page-hero-media"><MediaFrame src={media['hardware-prototyping']} alt={mediaManifest['hardware-prototyping'].alt} caption="The work is administrative. The impact is human." credit={mediaManifest['hardware-prototyping'].credit} sizes="(max-width: 900px) 100vw, 38vw" priority /></div></div></section>
  <section class="section cream-field"><div class="measure split-argument"><h2>We are looking for people who can hold complexity without passing it along.</h2><div class="prose"><p>Trustora works across employment administration, client service, local context, and the employee experience. You do not need to have worked in every country. You do need to be curious, precise, and willing to name what you do not know.</p><p>We value thoughtful communication, strong follow-through, and people who can make an operating process feel calm without making it vague.</p></div></div></section>
  <section class="section dark-field"><div class="measure"><div class="section-head"><div><SectionLabel light>What matters here</SectionLabel><h2 class="mt-2">The way we work is part of the work.</h2></div></div><div class="service-path"><div class="service-path-item"><span>01</span><h3>Be clear</h3><p>Say what you mean, document what matters, and make the next step easy to find.</p></div><div class="service-path-item"><span>02</span><h3>Stay local</h3><p>Context is not a footnote. Ask the country question early.</p></div><div class="service-path-item"><span>03</span><h3>Keep learning</h3><p>Rules change. Good judgment starts with being willing to update your view.</p></div><div class="service-path-item"><span>04</span><h3>Care in public</h3><p>Make the employee experience visible in the way you design the system.</p></div></div></div></section>
  <section class="section orange-field"><div class="measure intro-slab"><div><SectionLabel light>Interested?</SectionLabel><h2 class="mt-2">Send a note, not a performance.</h2></div><div class="intro-body"><p>Share what you are good at, what you want to learn, and where you think you could make the work better.</p><a class="button button-light" href="mailto:info@trustora.net?subject=Careers%20at%20Trustora">Email Trustora <span aria-hidden="true">↗</span></a></div></div></section>
</Layout>
