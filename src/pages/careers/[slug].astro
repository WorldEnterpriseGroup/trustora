---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SectionLabel from '../../components/editorial/SectionLabel.astro';
import CareersApplicationForm from '../../components/careers/CareersApplicationForm.astro';

export async function getStaticPaths() {
  const careers = await getCollection('careers', ({ data }) => data.draft !== true);
  const roleOptions = careers
    .filter(({ data }) => data.status !== 'Closed')
    .map(({ id, data }) => ({ id, title: data.title }));
  return careers.map((career) => ({ params: { slug: career.id }, props: { career, roleOptions } }));
}

interface RoleOption {
  id: string;
  title: string;
}

interface Props {
  career: CollectionEntry<'careers'>;
  roleOptions: RoleOption[];
}

const { career, roleOptions } = Astro.props;
const { Content } = await render(career);
const isClosed = career.data.status === 'Closed';
const roleStatusLabel = isClosed ? 'Closed role' : career.data.status === 'Talent pool' ? 'Talent pool' : 'Open role';
const applyLabel = career.data.status === 'Talent pool' ? 'Express interest' : 'Apply for this role';
---

<Layout title={career.data.title} seoTitle={`${career.data.title} | Trustora`} description={career.data.description} currentPath={`/careers/${career.id}/`} noindex={isClosed}>
  <section class="career-detail-hero">
    <div class="measure career-detail-hero__grid">
      <div class="career-detail-hero__copy">
        <a class="career-detail-back" href="/careers/">Careers at Trustora <span aria-hidden="true">↖</span></a>
        <SectionLabel>{roleStatusLabel}</SectionLabel>
        <h1>{career.data.title}</h1>
        <p class="career-detail-dek">{career.data.description}</p>
        <p class="career-detail-type"><span>{career.data.level}</span><span>{career.data.opportunityType}</span><span>{career.data.status}</span></p>
        {isClosed ? <a class="button button-quiet" href="/careers/#career-routes">View current careers <span aria-hidden="true">↗</span></a> : <a class="button" href="#apply">{applyLabel} <span aria-hidden="true">↘</span></a>}
      </div>
      <dl class="career-detail-meta" aria-label="Role details">
        <div><dt>Location</dt><dd>{career.data.location}</dd></div>
        <div><dt>Employment type</dt><dd>{career.data.employmentType}</dd></div>
        <div><dt>Level</dt><dd>{career.data.level}</dd></div>
        <div><dt>Opportunity</dt><dd>{career.data.opportunityType}</dd></div>
        <div><dt>Department</dt><dd>{career.data.department}</dd></div>
        <div><dt>Reports to</dt><dd>{career.data.reportsTo}</dd></div>
      </dl>
    </div>
  </section>

  <section class="section cream-field career-detail-description" aria-labelledby="career-description-title">
    <div class="measure career-detail-description__grid">
      <div class="career-detail-description__intro">
        <SectionLabel>Role description</SectionLabel>
        <h2 id="career-description-title">The work, standards, and outcomes.</h2>
        <p>{isClosed ? 'This listing is retained for clarity; review current routes before applying.' : 'Read the complete description before using the application form below.'}</p>
      </div>
      <article class="prose career-detail-content">
        <Content />
      </article>
    </div>
  </section>

  <section class="section dark-field career-detail-apply" aria-labelledby="career-apply-title">
    <div class="measure career-detail-apply__grid">
      <div><SectionLabel light>Next step</SectionLabel><h2 id="career-apply-title">{isClosed ? 'This role is closed.' : 'Apply for this role.'}</h2></div>
      <div class="career-detail-apply__body">
        {isClosed ? <p>This opportunity is not accepting applications. Review the current career routes for other fellowship, paid, and talent-pool paths.</p> : <p>The application form below is already set to this role. Share an outline of your experience, context, and the work you want to do.</p>}
        <div class="career-detail-apply__actions">
          {isClosed ? <a class="button button-light" href="/careers/#career-routes">View current careers <span aria-hidden="true">↗</span></a> : <a class="button button-light" href="#apply">{applyLabel} <span aria-hidden="true">↘</span></a>}
          <a class="career-detail-apply__back" href="/careers/">View all careers <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>
  {!isClosed && <CareersApplicationForm roleTitle={career.data.title} roleOptions={roleOptions} />}
</Layout>

<style>
  .career-detail-hero { padding: var(--space-4) 0 var(--space-5); background: var(--mist); }
  .career-detail-hero__grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(16rem, 0.7fr); gap: clamp(2rem, 8vw, 8rem); align-items: end; }
  .career-detail-hero__copy { max-width: 47rem; }
  .career-detail-back { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--accent-deep); font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.07em; text-decoration: none; text-transform: uppercase; }
  .career-detail-hero .section-label { margin-top: 3.2rem; }
  .career-detail-hero h1 { max-width: 16ch; margin-top: 1.05rem; }
  .career-detail-dek { max-width: 47rem; margin-top: 1.35rem; color: var(--muted); font-size: var(--step-1); }
  .career-detail-type { display: flex; flex-wrap: wrap; gap: 0.55rem 1rem; margin-top: 1rem; color: var(--accent-deep); font-family: var(--mono); font-size: 0.65rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .career-detail-type span + span { padding-left: 1rem; border-left: 1px solid var(--line-strong); }
  .career-detail-hero .button { margin-top: 1.7rem; }
  .career-detail-meta { display: grid; border-top: 1px solid var(--line-strong); }
  .career-detail-meta div { display: grid; grid-template-columns: minmax(6rem, 0.55fr) minmax(0, 1fr); gap: 1rem; padding: 0.9rem 0; border-bottom: 1px solid var(--line); }
  .career-detail-meta dt { color: var(--accent-deep); font-family: var(--mono); font-size: 0.64rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; }
  .career-detail-meta dd { color: var(--ink); font-size: 0.84rem; overflow-wrap: anywhere; }
  .career-detail-description__grid { display: grid; grid-template-columns: minmax(13rem, 0.56fr) minmax(0, 1.44fr); gap: clamp(2rem, 8vw, 9rem); align-items: start; }
  .career-detail-description__intro { position: sticky; top: 1rem; }
  .career-detail-description__intro h2 { max-width: 12ch; margin-top: 0.9rem; }
  .career-detail-description__intro p { max-width: 24ch; margin-top: 1.2rem; color: var(--muted); font-size: 0.84rem; }
  .career-detail-content { min-width: 0; color: var(--muted); }
  .career-detail-content :global(h2) { scroll-margin-top: 1rem; color: var(--ink); font-size: clamp(1.65rem, 1.35rem + 1vw, 2.5rem); }
  .career-detail-content :global(p) { max-width: 68ch; }
  .career-detail-apply__grid { display: grid; grid-template-columns: minmax(13rem, 0.7fr) minmax(0, 1.3fr); gap: clamp(2rem, 8vw, 9rem); align-items: start; }
  .career-detail-apply h2 { max-width: 12ch; margin-top: 0.8rem; }
  .career-detail-apply__body { max-width: 44rem; padding-top: 0.35rem; }
  .career-detail-apply__body > p { color: rgba(255,253,248,0.78); font-size: var(--step-1); }
  .career-detail-apply__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.1rem 1.4rem; margin-top: 1.5rem; }
  .career-detail-apply__back { color: var(--white); font-size: 0.75rem; font-weight: 800; letter-spacing: 0.07em; text-decoration: none; text-transform: uppercase; }
  @media (max-width: 900px) {
    .career-detail-hero__grid, .career-detail-description__grid, .career-detail-apply__grid { grid-template-columns: 1fr; gap: var(--space-3); }
    .career-detail-hero h1 { max-width: 18ch; }
    .career-detail-meta { margin-top: var(--space-2); }
    .career-detail-description__intro { position: static; }
    .career-detail-description__intro h2, .career-detail-apply h2 { max-width: 20ch; }
  }
  @media (max-width: 560px) {
    .career-detail-meta div { grid-template-columns: 1fr; gap: 0.25rem; }
    .career-detail-type { display: grid; gap: 0.35rem; }
    .career-detail-type span + span { padding-left: 0; border-left: 0; }
    .career-detail-apply__actions { align-items: flex-start; flex-direction: column; }
  }
</style>
