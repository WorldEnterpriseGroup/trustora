---
import Layout from '../layouts/Layout.astro';
import SectionLabel from '../components/editorial/SectionLabel.astro';
---

<Layout title="Page not found | Trustora" description="The page you requested could not be found." currentPath="/404/" noindex>
  <section class="section dark-field"><div class="measure intro-slab"><div><SectionLabel light>404 / Not found</SectionLabel><h1 class="mt-2">This page took the long way around.</h1></div><div class="intro-body"><p>The link may have moved, or the page may never have existed. Start again from the service map or head home.</p><div class="hero-actions"><a class="button button-light" href="/">Back to Trustora <span aria-hidden="true">↗</span></a><a class="button" href="/services/">Explore services <span aria-hidden="true">↗</span></a></div></div></div></section>
</Layout>
