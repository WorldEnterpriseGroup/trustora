---
import Layout from '../../layouts/Layout.astro';
import SectionLabel from '../../components/editorial/SectionLabel.astro';
import { locations } from '../../data/locations';

export function getStaticPaths() { return locations.map((location) => ({ params: { slug: location.slug }, props: { location } })); }
interface Props { location: (typeof locations)[number]; }
const { location } = Astro.props;
---

<Layout title={`${location.title} | Trustora`} description={location.short} currentPath={`/locations/${location.slug}/`}>
  <section class="page-hero location-hero"><div class="measure page-hero-grid"><div class="page-hero-copy"><SectionLabel>{location.number} / Location brief</SectionLabel><h1>{location.thesis}</h1><p>{location.body}</p><div class="hero-actions"><a class="button" href="/contact/">Discuss this market <span aria-hidden="true">↗</span></a></div></div><div class="page-hero-note">{location.title}<br />EoR · specialist employment · local context</div></div></section>
  <section class="section cream-field"><div class="measure"><div class="section-head"><div><SectionLabel>What to watch</SectionLabel><h2 class="mt-2">The details that shape the employee experience.</h2></div><p>Use these as prompts for diligence and local advice—not as a substitute for country-specific counsel.</p></div><div class="question-grid">{location.watch.map((item, index) => <div class="question-card"><span>0{index + 1}</span><p>{item}</p></div>)}</div></div></section>
  <section class="section blue-field"><div class="measure intro-slab"><div><SectionLabel>Make the next hire legible</SectionLabel><h2 class="mt-2">A local employment layer for specialist work.</h2></div><div class="intro-body"><p>Tell us the role, where the person will work, and what the team is trying to build. We will help frame the EoR conversation and the next local questions.</p><div class="hero-actions"><a class="button" href="/eor-brief/">Access the EoR brief <span aria-hidden="true">↗</span></a><a class="button button-quiet" href="/services/employer-of-record/">Explore EoR <span aria-hidden="true">↗</span></a></div></div></div></section>
</Layout>
