---
import Layout from '../../layouts/Layout.astro';
import SectionLabel from '../../components/editorial/SectionLabel.astro';
import { briefings } from '../../data/briefings';
---

<Layout title="Executive briefs | Trustora" description="Trustora’s executive briefs for Employer of Record decisions, specialist talent expansion, and cross-border employment models." currentPath="/briefings/">
  <section class="page-hero briefing-index-hero"><div class="measure page-hero-grid"><div class="page-hero-copy"><SectionLabel>Prepared for the decision</SectionLabel><h1>Executive briefs for the employment layer behind frontier work.</h1><p>Use these instruments before the role, country, or employment model hardens into a decision.</p></div><div class="page-hero-note">No hype. No borrowed benchmark. A practical frame for the next conversation.</div></div></section>
  <section class="section cream-field"><div class="measure"><div class="briefing-library-grid">{briefings.map((brief) => <article class="briefing-library-card"><div class="briefing-signal" data-accent={brief.accent}><span></span><i></i><span></span></div><div class="briefing-meta"><span>{brief.format}</span><span>{brief.audience}</span></div><h2>{brief.title}</h2><p>{brief.dek}</p><div class="briefing-takeaway"><strong>Use it when</strong><span>{brief.signal}</span></div><a class="button button-quiet" href={`/briefings/${brief.slug}/`}>Open the brief <span aria-hidden="true">↗</span></a></article>)}</div></div></section>
  <section class="section dark-field"><div class="measure split-argument"><h2>The document frames the question. The working session uses the live decision.</h2><div class="prose"><p>Bring an unresolved employment, talent, or country decision into a focused conversation with Trustora.</p><p><a href="/briefings/employer-of-record-operating-brief/">Start with the flagship EoR brief</a> or <a href="/contact/">contact the team directly</a>.</p></div></div></section>
</Layout>
