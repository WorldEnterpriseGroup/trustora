---
import Layout from '../../layouts/Layout.astro';
import SectionLabel from '../../components/editorial/SectionLabel.astro';
import Field from '../../components/primitives/Field.astro';
import { briefings } from '../../data/briefings';

export function getStaticPaths() { return briefings.map((brief) => ({ params: { slug: brief.slug }, props: { brief } })); }
interface Props { brief: (typeof briefings)[number]; }
const { brief } = Astro.props;
---

<Layout title={`${brief.title} | Trustora`} description={brief.dek} currentPath={`/briefings/${brief.slug}/`}>
  <section class="briefing-detail-hero"><div class="measure"><div class="briefing-detail-meta"><a href="/briefings/">Executive briefs</a><span>{brief.format}</span></div><SectionLabel>{brief.audience}</SectionLabel><h1>{brief.title}</h1><p>{brief.dek}</p></div></section>
  <section class="briefing-thesis"><div class="measure briefing-thesis-grid"><div><span>Core proposition</span><p>{brief.thesis}</p></div><div><span>Designed for</span><p>{brief.audience}</p></div></div></section>
  <section class="section cream-field"><div class="measure briefing-detail-grid"><div><SectionLabel>Inside the brief</SectionLabel><h2 class="mt-2">A working instrument, not a trend summary.</h2><p class="text-muted mt-3">The full brief includes the reasoning, questions, and practical prompts needed to use the material with a leadership or hiring team.</p><div class="briefing-preview-list">{brief.preview.map((item) => <div><span aria-hidden="true">↗</span><p>{item}</p></div>)}</div></div><div class="briefing-gate"><p class="section-label">Access the brief</p><h2>Release the working material.</h2><p>Share enough context for Trustora to understand which employment question is alive. The brief remains useful even if you are early in the decision.</p><form class="form-stack" action="mailto:info@trustora.net" method="post" enctype="text/plain"><Field id="name" label="Your name" required placeholder="Your name" /><Field id="email" label="Work email" type="email" required placeholder="you@company.com" /><Field id="company" label="Company" placeholder="Company name" /><div class="field"><label for="brief-context">What are you deciding?</label><textarea id="brief-context" name="context" placeholder="Country, role, timing, or question."></textarea></div><p class="form-note">No sensitive personal information. This is an operational starting point, not legal or tax advice.</p><button class="button" type="submit">Request the brief <span aria-hidden="true">↗</span></button></form></div></div></section>
  <section class="section blue-field"><div class="measure"><div class="section-head"><div><SectionLabel>Use it in the room</SectionLabel><h2 class="mt-2">What the brief should make easier.</h2></div><p>{brief.signal}</p></div><div class="outcome-grid">{brief.outcomes.map((outcome) => <div><span aria-hidden="true">↗</span><p>{outcome}</p></div>)}</div></div></section>
  <section class="section cream-field"><div class="measure"><div class="section-head"><div><SectionLabel>Working questions</SectionLabel><h2 class="mt-2">Open the decision before the paperwork.</h2></div><p>Bring these prompts into the next conversation. They are designed to expose assumptions, not create false certainty.</p></div><div class="briefing-question-list">{brief.sections.map((section, index) => <article><span>0{index + 1}</span><div><h3>{section.title}</h3><p>{section.body}</p>{section.prompts && <ul>{section.prompts.map((prompt) => <li>{prompt}</li>)}</ul>}</div></article>)}</div></div></section>
  <section class="section dark-field"><div class="measure intro-slab"><div><SectionLabel light>Next step</SectionLabel><h2 class="mt-2">Turn the brief into a country and role conversation.</h2></div><div class="intro-body"><p>Talk with Trustora about the facts behind the decision. We will identify which questions need operational, legal, tax, immigration, or employee-experience attention.</p><a class="button button-light" href="/contact/">Talk to Trustora <span aria-hidden="true">↗</span></a></div></div></section>
</Layout>
