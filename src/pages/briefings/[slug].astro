---
import Layout from '../../layouts/Layout.astro';
import SectionLabel from '../../components/editorial/SectionLabel.astro';
import Field from '../../components/primitives/Field.astro';
import { briefings } from '../../data/briefings';

export function getStaticPaths() { return briefings.map((brief) => ({ params: { slug: brief.slug }, props: { brief } })); }
interface Props { brief: (typeof briefings)[number]; }
const { brief } = Astro.props;
const intakeEndpoint = import.meta.env.PUBLIC_TRUSTORA_INTAKE_API_URL?.trim();
if (!intakeEndpoint) throw new Error('PUBLIC_TRUSTORA_INTAKE_API_URL must be configured for D365-only form delivery');
try {
  if (new URL(intakeEndpoint).protocol !== 'https:') throw new Error('not_https');
} catch {
  throw new Error('PUBLIC_TRUSTORA_INTAKE_API_URL must be a valid HTTPS URL');
}
---

<Layout title={brief.title} seoTitle={`${brief.title} | Trustora`} description={brief.dek} currentPath={`/briefings/${brief.slug}/`}>
  <section class="briefing-detail-hero"><div class="measure"><div class="briefing-detail-meta"><a href="/briefings/">Executive briefs</a><span>{brief.format}</span></div><SectionLabel>{brief.audience}</SectionLabel><h1>{brief.title}</h1><p>{brief.dek}</p></div></section>
  <section class="briefing-thesis"><div class="measure briefing-thesis-grid"><div><span>Core proposition</span><p>{brief.thesis}</p></div><div><span>Designed for</span><p>{brief.audience}</p></div></div></section>
  <section class="section cream-field"><div class="measure briefing-detail-grid"><div><SectionLabel>Inside the brief</SectionLabel><h2 class="mt-2">A working instrument, not a trend summary.</h2><p class="text-muted mt-3">The full brief includes the reasoning, questions, and practical prompts needed to use the material with a leadership or hiring team.</p><div class="briefing-preview-list">{brief.preview.map((item) => <div><span aria-hidden="true">↗</span><p>{item}</p></div>)}</div></div><div class="briefing-gate"><p class="section-label">Access the brief</p><h2>Release the working material.</h2><p>Share enough context for Trustora to understand which employment question is alive. The brief remains useful even if you are early in the decision.</p><form class="form-stack" action={intakeEndpoint} method="post" enctype="application/x-www-form-urlencoded" data-d365-form data-intake-type="briefing" data-corporate-email-only><input type="hidden" name="source" value={`trustora.net/briefings/${brief.slug}/`} /><input type="hidden" name="business-unit" value="Trustora" /><input type="hidden" name="schema-version" value="trustora-public-intake-v1" /><input type="hidden" name="intake-type" value="briefing" /><input type="hidden" name="briefing-slug" value={brief.slug} /><input type="hidden" name="application-id" value="" /><label class="sr-only" for="brief-website">Leave this field empty</label><input id="brief-website" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="d365-form__honeypot" /><Field id="name" label="Your name" required placeholder="Your name" /><Field id="email" label="Work email" type="email" required placeholder="you@company.com" /><Field id="company" label="Company" placeholder="Company name" /><div class="field"><label for="brief-context">What are you deciding?</label><textarea id="brief-context" name="context" placeholder="Country, role, timing, or question."></textarea></div><p class="form-note">Company email required. Gmail, Yahoo, Hotmail, and Outlook.com accounts are not eligible for this brief. No sensitive personal information. Your submission is validated by Trustora’s intake service and routed to D365 for review.</p><fieldset class="check-fieldset d365-consent-fieldset"><legend>Permission to contact</legend><label class="check-option"><input type="checkbox" name="safe-to-contact" value="yes" required /> I confirm this outline does not contain sensitive personal information and may be used to prepare an initial Trustora conversation.</label></fieldset><button class="button" type="submit">Request the brief <span aria-hidden="true">↗</span></button></form></div></div></section>
  <section class="section blue-field"><div class="measure"><div class="section-head"><div><SectionLabel>Use it in the room</SectionLabel><h2 class="mt-2">What the brief should make easier.</h2></div><p>{brief.signal}</p></div><div class="outcome-grid">{brief.outcomes.map((outcome) => <div><span aria-hidden="true">↗</span><p>{outcome}</p></div>)}</div></div></section>
  <section class="section cream-field"><div class="measure"><div class="section-head"><div><SectionLabel>Working questions</SectionLabel><h2 class="mt-2">Open the decision before the paperwork.</h2></div><p>Bring these prompts into the next conversation. They are designed to expose assumptions, not create false certainty.</p></div><div class="briefing-question-list">{brief.sections.map((section, index) => <article><span>0{index + 1}</span><div><h3>{section.title}</h3><p>{section.body}</p>{section.prompts && <ul>{section.prompts.map((prompt) => <li>{prompt}</li>)}</ul>}</div></article>)}</div></div></section>
  <section class="section dark-field"><div class="measure intro-slab"><div><SectionLabel light>Next step</SectionLabel><h2 class="mt-2">Turn the brief into a country and role conversation.</h2></div><div class="intro-body"><p>Talk with Trustora about the facts behind the decision. We will identify which questions need operational, legal, tax, immigration, or employee-experience attention.</p><a class="button button-light" href="/contact/">Talk to Trustora <span aria-hidden="true">↗</span></a></div></div></section>
</Layout>
