---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import MediaFrame from '../../components/editorial/MediaFrame.astro';
import SectionLabel from '../../components/editorial/SectionLabel.astro';
import ArticleCard from '../../components/editorial/ArticleCard.astro';
import { media } from '../../data/media';
import { mediaManifest } from '../../data/site';
import { articlePath, getPublishedArticles } from '../../utils/articles';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => data.draft !== true);
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

interface Props { article: CollectionEntry<'articles'>; }
const { article } = Astro.props;
const { Content, headings } = await render(article);
const relatedArticles = (await getPublishedArticles()).filter((item) => article.data.related.includes(item.id));
const articleImage = media[article.data.imageKey];
---

<Layout title={article.data.title} seoTitle={`${article.data.title} | Trustora`} description={article.data.description} currentPath={articlePath(article.id)} type="article" publishedAt={article.data.publishedAt} updatedAt={article.data.updatedAt}>
  <section class="article-hero"><div class="measure article-hero-grid"><div><SectionLabel>{article.data.category}</SectionLabel><h1>{article.data.title}</h1><p class="article-dek">{article.data.lede}</p><div class="article-meta"><span>{article.data.publishedAt.toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'short', day: 'numeric' })}</span><span>{article.data.readTime}</span><span>By Trustora</span></div></div><div class="article-hero-media"><MediaFrame src={articleImage} alt={article.data.imageAlt} caption={article.data.imageCaption} credit={mediaManifest[article.data.imageKey].credit} sizes="(max-width: 900px) 100vw, 55vw" priority /></div></div></section>
  <div class="measure article-layout">
    <aside class="article-aside" aria-label="On this page"><h2>On this page</h2><ol>{headings.filter((heading) => heading.depth === 2).map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></aside>
    <article class="article-content"><div class="prose"><Content /></div>{article.data.sources.length > 0 && <section class="source-notes" aria-labelledby="sources-title"><h2 id="sources-title">Sources and further reading</h2><ul>{article.data.sources.map((source) => <li><a href={source.url} rel="noreferrer">{source.label} ↗</a></li>)}</ul></section>}</article>
    <blockquote class="article-pullquote">“Clear boundaries are part of good service.”</blockquote>
  </div>
  {relatedArticles.length > 0 && <section class="section-tight cream-field"><div class="measure"><div class="section-head"><div><SectionLabel>Keep reading</SectionLabel><h2 class="mt-2">More from this question.</h2></div></div><div class="article-grid">{relatedArticles.map((related) => <ArticleCard article={related} showImage={false} />)}</div></div></section>}
</Layout>
