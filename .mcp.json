{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/home/runner/work"],
      "env": {
        "FILESYSTEM_ALLOW_DELETE": "true",
        "FILESYSTEM_ALLOW_WRITE": "true",
        "FILESYSTEM_ALLOW_CREATE": "true"
      }
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    },
    "calculator": {
      "command": "npx",
      "args": ["-y", "mcp-calculator-server"]
    },
    "everything": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-everything"]
    }
  }
}